+// device DmL10n.t returns the Chinese of a text, elsewhere the text itself, so nothing changes for anyone else. The setting
+// texts are the Mac launcher's (frontend/l10n, launch.*), the same words the iOS shell's catalog carries (frontend-ios).
+enum DmL10n {
+    static let chinese = Locale.preferredLanguages.first?.hasPrefix("zh") == true
+    static func t(_ english: String) -> String { chinese ? (texts[english] ?? english) : english }
