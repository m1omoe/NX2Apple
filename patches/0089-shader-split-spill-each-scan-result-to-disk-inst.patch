+    """scan_file over jobs in the pool, yielding the results in job order, with a 'progress: <done>/<total>' line at most twice a second (the NSP script shows it as
+    the stage's count). The count is of the jobs finished in any order: counted in order it would stall behind one slow archive range while the others finish.
+    A generator, not a list: each result is yielded as its turn comes, so the caller can merge it and drop it instead of holding every file's shaders at
+    once, and a spilled result is loaded here and its file removed. Only the spill paths of finished batches are held meanwhile, which are small."""
     batches = [jobs[i:i + chunk] for i in range(0, len(jobs), chunk)]
     futures = {ex.submit(scan_batch, b): len(b) for b in batches}
+    order, landed, nxt = list(futures), {}, 0
     done, pending, shown = start, set(futures), 0.0
-    while pending:
-        finished, pending = cf.wait(pending, timeout=0.5)
-        done += sum(futures[f] for f in finished)
-        if not pending or time.monotonic() - shown >= 0.5: print(f'progress: {done}/{total}', flush=True); shown = time.monotonic()
-    return [r for f in futures for r in f.result()]
+    while pending or nxt < len(futures):
+        if pending:
+            finished, pending = cf.wait(pending, timeout=0.5)
+            done += sum(futures[f] for f in finished)
+            if not pending or time.monotonic() - shown >= 0.5: print(f'progress: {done}/{total}', flush=True); shown = time.monotonic()
+            for f in finished: landed[order.index(f)] = f.result()
+        while nxt in landed:
+            for item in landed.pop(nxt): yield _spilled(item)
+            nxt += 1
 
 
