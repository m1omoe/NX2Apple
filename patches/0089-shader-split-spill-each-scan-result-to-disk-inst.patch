 def scan_batch(jobs):   # scan_file over a batch of jobs, in a pool worker
-    return [scan_file(j) for j in jobs]
+    # A batch's results come back through the pool's result queue, which pickles the whole batch into one bytes object: one file holding
+    # thousands of shaders is too large for that copy and dies with MemoryError in _sendback_result, after every file has already been
+    # scanned (Hyrule Warriors: Age of Imprisonment: 9,766 shaders, progress 2153/2153, then the failure). Spill each result to disk as
+    # it is scanned and send back only its path, so the queue carries small strings. A spill failure falls back to the in-memory
+    # result for that job, as before.
+    global _SPILL_N
+    out = []
+    for j in jobs:
+        r = scan_file(j)
+        if SPILL:
+            try:
+                _SPILL_N += 1
+                p = os.path.join(SPILL, f'{os.getpid()}_{_SPILL_N}.pkl')
+                with open(p, 'wb') as f: pickle.dump(r, f, protocol=4)
+                out.append(p); continue
+            except OSError:
+                pass
+        out.append(r)
+    return out
+
+
+def _spilled(item):
+    """A scan result spilled to disk by its worker, loaded and its file removed; anything else passes through (no spill, or the spill failed)."""
+    if not isinstance(item, str): return item
+    with open(item, 'rb') as f: r = pickle.load(f)
+    os.unlink(item)
+    return r
 
 
 def pooled(ex, jobs, total, start=0, chunk=1):
-    """scan_file over jobs in the pool, the results in job order, with a 'progress: <done>/<total>' line at most twice a second (the NSP script shows it as
